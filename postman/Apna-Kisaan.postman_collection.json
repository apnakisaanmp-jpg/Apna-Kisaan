{
  "info": {
    "_postman_id": "5ba54f09-3f02-4e60-9e33-5bbcc964e8ad",
    "name": "Apna Kisaan API",
    "description": "Apna Kisaan Laravel API: account auth, public content, live/fallback market prices, lead forms, and authenticated inquiries. Import this collection, set base_url, then register or log in to store a Bearer token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Account",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created account', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns user and Bearer token', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.user.email).to.be.a('string'); pm.expect(body.data.token).to.be.a('string'); pm.expect(body.data.user).to.not.have.property('password'); });",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Farmer\",\n  \"email\": \"farmer@example.com\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"secure-pass-123\",\n  \"password_confirmation\": \"secure-pass-123\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            },
            "description": "Creates an active user and returns a hashed-at-rest personal API token. Use a unique email each time."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);",
                  "pm.test('Token is stored for protected requests', function () { pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@example.com\",\n  \"password\": \"secure-pass-123\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Logout current token",
          "request": {
