            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_location\": \"दमोह\",\n  \"delivery_location\": \"भोपाल\",\n  \"vehicle_type\": \"truck\",\n  \"crop_name\": \"गेहूं\",\n  \"quantity\": 10,\n  \"preferred_date\": \"{{transport_date}}\",\n  \"mobile\": \"9876543210\",\n  \"notes\": \"लोडिंग का समय सुबह।\"\n}"
            },
            "url": {
