              ],
              "path": [
                "api",
                "transport-bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 1);",
                  "pm.variables.set('transport_date', date.toISOString().slice(0, 10));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
