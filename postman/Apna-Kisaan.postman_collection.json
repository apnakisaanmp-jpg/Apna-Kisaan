    {
      "name": "03 - Market prices",
      "item": [
        {
          "name": "All mandi prices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mandi-bhav?q=wheat&is_mp=1&min_price=1000&sort=modal_price&order=desc&page=1&per_page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mandi-bhav"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "wheat",
                  "description": "Search Hindi/English crop, market, district, or category."
                },
                {
                  "key": "is_mp",
                  "value": "1",
                  "description": "1 = records marked MP-relevant; 0 = other records."
                },
                {
                  "key": "min_price",
                  "value": "1000"
                },
                {
                  "key": "sort",
                  "value": "modal_price"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            },
            "description": "Filters actual records from the configured farmer.in open-data feed and returns feed attribution/fallback metadata."
          }
