{
  "info": {
    "name": "Apna Kisaan API",
    "description": "Authentication, market data, farmer inquiries, registrations, transport bookings, and profile APIs for Apna Kisaan Laravel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "api_token", "value": "" },
    { "key": "user_email", "value": "user@apnakisaan.in" },
    { "key": "user_password", "value": "User@123456" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register farmer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Farmer\",\n  \"email\": \"farmer{{$timestamp}}@example.com\",\n  \"mobile\": \"9876543210\",\n  \"password\": \"User@123456\",\n  \"password_confirmation\": \"User@123456\"\n}" },
            "url": "{{base_url}}/register"
          }
        },
        {
          "name": "Login and save token",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login succeeded', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });", "var json = pm.response.json();", "if (json.data && json.data.token) pm.collectionVariables.set('api_token', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}" },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "Profile",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{api_token}}" }], "url": "{{base_url}}/profile" }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{api_token}}" }], "url": "{{base_url}}/logout" }
        }
      ]
    },
    {
      "name": "Public data",
      "item": [
        { "name": "Services", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/services" } },
        { "name": "Service detail", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/services/1" } },
        { "name": "Districts", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/districts" } },
        { "name": "Market prices", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/market-price" } },
        { "name": "Vegetable prices", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/vegetable-price" } },
        { "name": "Crop prices", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{base_url}}/crop-price" } }
      ]
    },
    {
      "name": "Lead forms",
      "item": [
        {
          "name": "Contact inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"phone\": \"9876543210\",\n  \"district\": \"Damoh\",\n  \"subject\": \"Mandi information\",\n  \"vegetable\": \"Tomato\",\n  \"message\": \"Please share today's market price.\"\n}" },
            "url": "{{base_url}}/inquiries"
          }
        },
        {
          "name": "Farmer registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"farmer\",\n  \"name\": \"Ramesh Kumar\",\n  \"mobile\": \"9876543210\",\n  \"district\": \"Damoh\",\n  \"village\": \"Hatta\",\n  \"main_crop\": \"Soybean\"\n}" },
            "url": "{{base_url}}/farmer-registrations"
          }
        },
        {
          "name": "Transport booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pickup_location\": \"Hatta, Damoh\",\n  \"delivery_location\": \"Indore Mandi\",\n  \"vehicle_type\": \"truck\",\n  \"crop_name\": \"Soybean\",\n  \"quantity\": 12.5,\n  \"preferred_date\": \"2026-09-20\",\n  \"mobile\": \"9876543210\"\n}" },
            "url": "{{base_url}}/transport-bookings"
          }
        }
      ]
    }
  ]
}
